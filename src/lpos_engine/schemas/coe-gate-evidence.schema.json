{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listeningpost.ai/schemas/coe-gate-evidence.schema.json",
  "title": "LPOS COE gate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "audit_id", "gate_id", "gate_version", "status",
    "started_at", "completed_at", "duration_ms", "executable", "arguments", "exit_code",
    "release", "git_commit", "input_hashes", "checks", "stdout_sha256", "stderr_sha256",
    "artifacts", "previous_evidence_hash", "evidence_hash", "source"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "minLength": 20},
    "audit_id": {"type": "string", "minLength": 20},
    "gate_id": {"enum": ["deterministic-tests", "application-release-verifier", "doctor", "engineering-audit", "security-reliability-audit", "documentation-audit", "bloat-audit", "opportunity-audit", "release-integrity"]},
    "gate_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "error", "skipped"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "executable": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "items": {"type": "string"}},
    "exit_code": {"type": ["integer", "null"]},
    "signal": {"type": ["string", "null"]},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "release_version", "release_channel", "git_commit", "build_id", "artifact_sha256"],
      "properties": {
        "product": {"type": "string"}, "release_version": {"type": "string"},
        "release_channel": {"type": "string"}, "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "build_id": {"type": "string"}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["check_id", "status", "detail"], "properties": {"check_id": {"type": "string"}, "status": {"enum": ["pass", "fail", "error", "unknown"]}, "detail": {"type": "string"}}, "additionalProperties": true}},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stdout_excerpt": {"type": "string", "maxLength": 16384},
    "stderr_excerpt": {"type": "string", "maxLength": 16384},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}},
    "previous_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"const": "command"}
  }
}
