{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lpos.dev/schemas/managed-run.schema.json",
  "title": "LPOS Managed Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "status", "risk_tier", "workdir", "specialist_id", "reviewer_id", "max_corrections", "events", "completion_latch"],
  "properties": {
    "schema": {"const": "lpos.managed-run.v1"},
    "run_id": {"type": "string", "minLength": 3},
    "status": {"enum": ["preflight", "executing", "reviewing", "correcting", "completed", "capability_gap", "failed"]},
    "risk_tier": {"enum": ["read-only", "local-implementation", "consequential"]},
    "workdir": {"type": "string", "minLength": 1},
    "specialist_id": {"type": "string", "minLength": 3},
    "reviewer_id": {"type": "string", "minLength": 3},
    "max_corrections": {"type": "integer", "minimum": 0, "maximum": 2},
    "events": {"type": "array", "items": {"type": "object"}},
    "completion_latch": {"type": "boolean"},
    "correction_cycle": {"type": "integer", "minimum": 0, "maximum": 2},
    "capability_gap": {"type": "array", "items": {"type": "string"}},
    "preflight": {"type": "object"},
    "contribution": {"type": "object"},
    "failure": {"type": "string", "minLength": 1},
    "correction_cycles": {"type": "integer", "minimum": 0, "maximum": 2},
    "artifact": {"type": "object"},
    "source": {"type": "object"},
    "checks": {"type": "array", "items": {"type": "object"}},
    "review": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"completion_latch": {"const": true}}}},
    {"if": {"properties": {"completion_latch": {"const": true}}}, "then": {"properties": {"status": {"const": "completed"}}}}
  ]
}
